{
  "name": "Video Editor Workflow",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "operation", "value": "trim" },
            { "name": "inputPath", "value": "/home/node/video.mp4" },
            { "name": "outputPath", "value": "/home/node/output.mp4" },
            { "name": "startTime", "value": "00:01:30" },
            { "name": "duration", "value": "30" },
            { "name": "width", "value": "1280" },
            { "name": "height", "value": "720" },
            { "name": "watermarkPath", "value": "/home/node/watermark.png" },
            { "name": "watermarkPosition", "value": "10:10" },
            { "name": "speed", "value": "2.0" },
            { "name": "bitrate", "value": "2000k" },
            { "name": "codec", "value": "libx264" },
            { "name": "audioCodec", "value": "aac" }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Video Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [430, 300]
    },
    {
      "id": "switch",
      "name": "Select Operation",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [620, 300],
      "parameters": {
        "dataType": "string",
        "fieldName": "operation",
        "switch": {
          "values": [
            { "value": "trim" },
            { "value": "resize" },
            { "value": "convert" },
            { "value": "watermark" },
            { "value": "concat" },
            { "value": "extractAudio" },
            { "value": "speed" },
            { "value": "subtitle" }
          ]
        },
        "fallbackOutput": ""
      }
    },
    {
      "parameters": {
        "command": "=ffmpeg -i \"{{ $json.inputPath }}\" -ss {{ $json.startTime }} -t {{ $json.duration }} -c:v {{ $json.codec }} -c:a {{ $json.audioCodec }} -b:v {{ $json.bitrate }} \"{{ $json.outputPath }}\" -y",
        "options": {}
      },
      "id": "trim",
      "name": "Trim / Cut Video",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [810, 140]
    },
    {
      "parameters": {
        "command": "=ffmpeg -i \"{{ $json.inputPath }}\" -vf \"scale={{ $json.width }}:{{ $json.height }}\" -c:v {{ $json.codec }} -c:a {{ $json.audioCodec }} -b:v {{ $json.bitrate }} \"{{ $json.outputPath }}\" -y",
        "options": {}
      },
      "id": "resize",
      "name": "Resize Video",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [810, 260]
    },
    {
      "parameters": {
        "command": "=ffmpeg -i \"{{ $json.inputPath }}\" -c:v {{ $json.codec }} -c:a {{ $json.audioCodec }} -b:v {{ $json.bitrate }} \"{{ $json.outputPath }}\" -y",
        "options": {}
      },
      "id": "convert",
      "name": "Convert Format",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [810, 380]
    },
    {
      "parameters": {
        "command": "=ffmpeg -i \"{{ $json.inputPath }}\" -i \"{{ $json.watermarkPath }}\" -filter_complex \"overlay={{ $json.watermarkPosition }}\" -c:v {{ $json.codec }} -c:a {{ $json.audioCodec }} -b:v {{ $json.bitrate }} \"{{ $json.outputPath }}\" -y",
        "options": {}
      },
      "id": "watermark",
      "name": "Add Watermark",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [810, 500]
    },
    {
      "parameters": {
        "command": "=ffmpeg -f concat -safe 0 -i \"{{ $json.inputPath }}\" -c copy \"{{ $json.outputPath }}\" -y",
        "options": {}
      },
      "id": "concat",
      "name": "Concatenate Videos",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [810, 620]
    },
    {
      "parameters": {
        "command": "=ffmpeg -i \"{{ $json.inputPath }}\" -vn -c:a {{ $json.audioCodec }} \"{{ $json.outputPath }}\" -y",
        "options": {}
      },
      "id": "extractAudio",
      "name": "Extract Audio",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [810, 740]
    },
    {
      "parameters": {
        "command": "=ffmpeg -i \"{{ $json.inputPath }}\" -filter:v \"setpts={{ $json.speed | replace('.', '') }}/{{ $json.speed }}*PTS\" -filter:a \"atempo={{ $json.speed }}\" -c:v {{ $json.codec }} -b:v {{ $json.bitrate }} \"{{ $json.outputPath }}\" -y",
        "options": {}
      },
      "id": "speed",
      "name": "Change Speed",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [810, 860]
    },
    {
      "parameters": {
        "command": "=ffmpeg -i \"{{ $json.inputPath }}\" -vf \"subtitles={{ $json.watermarkPath | replace('\\'', '\\\\\\'') }}\" -c:v {{ $json.codec }} -c:a {{ $json.audioCodec }} -b:v {{ $json.bitrate }} \"{{ $json.outputPath }}\" -y",
        "options": {}
      },
      "id": "subtitle",
      "name": "Add Subtitles",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [810, 980]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "output",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1000, 300]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Video Config", "type": "main", "index": 0 }]]
    },
    "Video Config": {
      "main": [[{ "node": "Select Operation", "type": "main", "index": 0 }]]
    },
    "Select Operation": {
      "main": [
        [{ "node": "Trim / Cut Video", "type": "main", "index": 0 }],
