# =============================================================================
# n8n TikTok Video Editor - Configuration
# =============================================================================
# Copy this file to .env and adjust values:
#   cp .env.example .env

# --- n8n Core ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=your-32-char-random-string-here-change-it

# --- Execution Settings ---
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168       # hours (7 days)
N8N_PAYLOAD_SIZE_MAX=256          # MB
N8N_METRICS=false

# --- Redis (queue mode) ---
REDIS_PORT=6379

# --- Storage Paths (must exist or be created) ---
VIDEO_STORAGE=./storage/videos
ASSET_STORAGE=./storage/assets
OUTPUT_STORAGE=./storage/output

# --- TikTok Publishing (optional) ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- AI / Captioning (optional) ---
OPENAI_API_KEY=
WHISPER_MODEL=base                # tiny/base/small/medium/large
CAPTION_LANGUAGE=en

# --- Social Media Sources (optional) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
TWITTER_BEARER_TOKEN=

# --- Notifications ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Monitoring ---
WATCHTOWER_POLL_INTERVAL=86400    # seconds (24h)

# --- Workflow Schedule (cron) ---
SCHEDULE_TREND_SCAN=0 */6 * * *   # every 6 hours
SCHEDULE_PUBLISH=0 9,15,21 * * *  # 3 times daily

# --- Default Video Settings ---
DEFAULT_WIDTH=1080
DEFAULT_HEIGHT=1920
DEFAULT_FPS=30
DEFAULT_BITRATE=4000k
DEFAULT_CODEC=libx264
DEFAULT_AUDIO_CODEC=aac
DEFAULT_TIKTOK_DURATION=30        # seconds max
DEFAULT_CAPTION_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
